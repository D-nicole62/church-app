{
  "name": "church-visitor-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:payments": "tsx --test src/lib/payments.test.ts",
    "test:mail": "tsx --test src/lib/mail/send.test.ts src/lib/auth/password.test.ts",
    "test:sermons": "tsx --test src/lib/sermons/youtube.test.ts",
    "test:e2e": "playwright test",
    "test:ci": "bash scripts/ci-local.sh",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:remove-test-records": "tsx scripts/remove-test-records.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.99.2",
    "bcryptjs": "^3.0.3",
    "next": "16.1.7",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
