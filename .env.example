# Database (PostgreSQL on Supabase today). Prisma is generated for PostgreSQL.
# A mysql:// URL will not work until the schema and driver are converted.
DATABASE_URL=
DIRECT_URL=

# Auth — do not use localhost on Vercel
AUTH_SECRET=
# Local dev only (optional; defaults to http://127.0.0.1:3000 when omitted):
# AUTH_URL=http://127.0.0.1:3000
# Production site (used when AUTH_URL is missing or still set to localhost on deploy):
NEXT_PUBLIC_APP_URL=https://church-app-ashy.vercel.app

# Give — online payments stay off unless this is exactly true, 1, yes, or on.
# Leave it unset (or false) until a payment gateway is chosen. Restart or
# redeploy after changing it. Lipila is the current gateway code; set
# LIPILA_API_KEY only when PAYMENTS_ENABLED is turned on.
PAYMENTS_ENABLED=false
LIPILA_API_KEY=
# Pending Lipila payments fail after this many seconds (default 180)
PAYMENT_TIMEOUT_SECONDS=180

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
