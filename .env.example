# Database (PostgreSQL on Supabase today). Prisma is generated for PostgreSQL.
# A mysql:// URL will not work until the schema and driver are converted.
DATABASE_URL=
DIRECT_URL=

# Auth — do not use localhost on Vercel
AUTH_SECRET=
# Local dev only (optional; defaults to http://127.0.0.1:3000 when omitted):
# AUTH_URL=http://127.0.0.1:3000
# Production site (used when AUTH_URL is missing or still set to localhost on deploy):
NEXT_PUBLIC_APP_URL=https://church-app-ashy.vercel.app

# Give — online payments stay off unless this is exactly true, 1, yes, or on.
# Leave it unset (or false) until a payment gateway is chosen. Restart or
# redeploy after changing it. Lipila is the current gateway code; set
# LIPILA_API_KEY only when PAYMENTS_ENABLED is turned on.
PAYMENTS_ENABLED=false
LIPILA_API_KEY=
# Pending Lipila payments fail after this many seconds (default 180)
PAYMENT_TIMEOUT_SECONDS=180

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email — pick one provider. EMAIL_PROVIDER=auto uses SMTP when
# SMTP_HOST, SMTP_USER, and SMTP_PASS are all set, otherwise Resend.
# EMAIL_PROVIDER=resend
# EMAIL_PROVIDER=smtp
EMAIL_FROM=
CHURCH_INBOX_EMAIL=

# Resend. EMAIL_FROM must use a domain you have verified in Resend.
# onboarding@resend.dev can only email the Resend account owner.
# RESEND_API_KEY is preferred. EMAIL_PROVIDER_API_KEY is a fallback name.
RESEND_API_KEY=
EMAIL_PROVIDER_API_KEY=

# Hostinger mailbox (or any SMTP server).
# Port 465 uses SSL. Port 587 uses STARTTLS, so set SMTP_SECURE=false.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true

# Optional. Sermons are listed from the public YouTube RSS feed with no key
# (about the latest 15 videos). Set a YouTube Data API v3 key to list more
# videos, page through them, and show a Live now banner when the channel
# is streaming. Restrict the key to the YouTube Data API.
# YOUTUBE_API_KEY=

# First admin created by prisma db seed. The default password ChangeMe123!
# forces a password change at the next sign-in.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
